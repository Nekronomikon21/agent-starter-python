# Keep the image small and never ship secrets or local cruft.
.venv
.git
.env
logs/
ideas/
__pycache__/
*.py[oc]
.pytest_cache/
.ruff_cache/
.DS_Store

# Claude Code worktrees — hundreds of MB of repo copies and virtualenvs.
.claude/
# .venv is matched at the root above; catch nested ones too.
**/.venv
